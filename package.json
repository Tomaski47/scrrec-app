{
  "name": "scrrec-app",
  "private": true,
  "version": "0.3.0",
  "description": "A local-first browser screen, camera, and microphone recorder from Sadilek Innovation.",
  "license": "MIT",
  "author": "Sadilek Innovation",
  "homepage": "https://screc.sadilekinnovation.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tomaski47/scrrec-app.git"
  },
  "bugs": {
    "url": "https://github.com/Tomaski47/scrrec-app/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:5174": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "start": "npm run dev",
    "build": "npm run typecheck && vite build",
    "build:experiments": "npm run typecheck && vite build --mode experiments",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test tests/*.test.ts",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "4.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "postcss": "^8.5.31",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
